{
  "name": "stat-pilot",
  "private": true,
  "version": "0.2.1",
  "description": "面向深圳市统计政务工作的本地智能工作台，支持统计信息采集、数据分析、来源核验与公文起草。",
  "author": {
    "name": "深小统",
    "email": "st0ff3l@users.noreply.github.com",
    "url": "https://github.com/St0ff3l/stat-pilot"
  },
  "homepage": "https://github.com/St0ff3l/stat-pilot",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "node scripts/patch-dsh-archive-plugin.mjs",
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1 --strictPort\" \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/watch-electron.mjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/watch-electron.mjs",
    "build": "tsc -b && vite build",
    "dist:mac": "npm run stage:dsh-node && npm run verify:runtime && npm run build && electron-builder --mac dmg",
    "dist:win": "npm run stage:dsh-node && npm run verify:runtime && npm run build && electron-builder --win nsis",
    "dist:linux": "npm run stage:dsh-node && npm run verify:runtime && npm run build && electron-builder --linux deb",
    "dist:linux:arm64": "npm run stage:dsh-node && npm run verify:runtime && npm run build && electron-builder --linux deb --arm64",
    "verify:runtime": "node scripts/verify-dsh-runtime.mjs",
    "stage:dsh-node": "node scripts/stage-dsh-node.mjs",
    "dsh:verify": "node scripts/verify-dsh-runtime.mjs",
    "verify:packaged-runtime": "node scripts/verify-packaged-dsh.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/dsh": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.7-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.7-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-time": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.7-rc.2",
    "@types/react": "^19.2.14",
    "csstype": "3.2.3",
    "dsh-archived-chats": "1.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "dsh-archived-chats": {
      "react": "$react"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.stoffel.szgovscope",
    "productName": "深小统",
    "icon": "src/assets/sz-logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "rules/**",
      "skills/**",
      "src/electron.d.ts",
      "package.json",
      "!**/._*",
      "!**/.DS_Store",
      "!**/.DS_Store/**"
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "rules",
        "to": "rules",
        "filter": [
          "**/*",
          "!**/._*",
          "!**/.DS_Store",
          "!**/.DS_Store/**"
        ]
      },
      {
        "from": "public/sz-logo.png",
        "to": "app-icon.png"
      },
      {
        "from": "public/sz-dock-icon.png",
        "to": "app-dock-icon.png"
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/._*",
          "!**/.DS_Store",
          "!**/.DS_Store/**"
        ]
      },
      {
        "from": ".runtime/dsh-node.exe",
        "to": "dsh-node.exe"
      }
    ],
    "mac": {
      "icon": "src/assets/sz-logo.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "stat-pilot-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "深小统使用麦克风将语音转换为聊天草稿。"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "stat-pilot-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "artifactName": "stat-pilot-${version}-Linux-${arch}.${ext}",
      "category": "Utility",
      "packageCategory": "utils",
      "synopsis": "深圳市统计局智能工作台",
      "description": "面向深圳市统计政务工作的本地智能工作台，支持统计信息采集、数据分析、来源核验与公文起草。",
      "maintainer": "深小统 <st0ff3l@users.noreply.github.com>",
      "vendor": "深小统"
    },
    "deb": {
      "packageName": "sz-gov-scope",
      "afterInstall": "scripts/kylin-after-install.sh",
      "afterRemove": "scripts/kylin-after-remove.sh"
    }
  }
}
