{
  "name": "sz-gov-scope",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1 --strictPort\" \"VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "electron .",
    "build": "tsc -b && vite build",
    "dist:mac": "npm run verify:runtime && npm run build && electron-builder --mac dmg",
    "dist:win": "npm run verify:runtime && npm run build && electron-builder --win nsis",
    "dist:linux": "npm run verify:runtime && npm run build && electron-builder --linux deb",
    "verify:runtime": "node scripts/verify-bundled-hermes-runtime.mjs",
    "hermes:patch": "node scripts/patch-hermes-runtime.mjs",
    "hermes:bootstrap": "bash scripts/bootstrap-hermes.sh",
    "hermes:bootstrap:quick": "HERMES_NON_INTERACTIVE=1 bash scripts/bootstrap-hermes.sh",
    "hermes:bootstrap:skip-setup": "HERMES_SKIP_SETUP=1 bash scripts/bootstrap-hermes.sh",
    "hermes:bootstrap:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-hermes.ps1",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.stoffel.szgovscope",
    "productName": "深统政务Scope",
    "icon": "src/assets/sz-logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "rules/**",
      "skills/**",
      "src/electron.d.ts",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".runtime",
        "to": ".runtime",
        "filter": [
          "**/*",
          "!**/.git",
          "!**/.git/**",
          "!hermes-home",
          "!hermes-home/**",
          "!**/node_modules/electron/dist/Electron.app/**"
        ]
      },
      {
        "from": "rules",
        "to": "rules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/sz-logo.png",
        "to": "app-icon.png"
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "src/assets/sz-logo.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "category": "Utility",
      "maintainer": "深统政务Scope"
    }
  }
}
