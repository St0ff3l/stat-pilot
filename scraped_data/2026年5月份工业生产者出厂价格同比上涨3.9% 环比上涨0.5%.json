        {"indicator_name": "工业生产者购进价格同比", "single_month_value": "5.8%", "single_month_yoy_growth": 5.8, "cumulative_value": "1.6%", "cumulative_yoy_growth": 1.6, "remarks": "1-5月平均"},
        {"indicator_name": "工业生产者购进价格环比", "single_month_value": "1.3%", "single_month_yoy_growth": null, "cumulative_value": null, "cumulative_yoy_growth": null, "remarks": ""}
      ]
