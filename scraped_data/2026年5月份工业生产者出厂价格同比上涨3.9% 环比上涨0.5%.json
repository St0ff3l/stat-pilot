      "section_index": 1,
      "section_heading": "概况",
      "raw_paragraph_text": "2026年5月份，全国工业生产者出厂价格同比上涨3.9%，环比上涨0.5%。工业生产者购进价格同比上涨5.8%，环比上涨1.3%。1—5月平均，工业生产者出厂价格比上年同期上涨1.0%，工业生产者购进价格上涨1.6%。",
      "section_indicators": [
        {"indicator_name": "工业生产者出厂价格同比", "single_month_value": "3.9%", "single_month_yoy_growth": 3.9, "cumulative_value": "1.0%", "cumulative_yoy_growth": 1.0, "remarks": "1-5月平均"},
